# Copy to .env to change defaults. Every value below is also the built-in default.
POSTGRES_USER=scats
POSTGRES_PASSWORD=scats_dev_pw
POSTGRES_DB=scats
DB_PORT=5432

# Password of the API's limited database role. If you change it, also change it in
# db/init/002_app_role.sql BEFORE the database volume is first created.
APP_DB_PASSWORD=scats_app_dev_pw

# S3 credentials. They must match config/seaweedfs-s3.json.
S3_ACCESS_KEY=scatsdev
S3_SECRET_KEY=scatsdev_secret_pw
S3_PORT=8333
STORAGE_UI_PORT=9333
# After the first successful pull, pin the exact image tag here:
# S3_IMAGE=chrislusf/seaweedfs:<tag from `docker compose images`>

API_PORT=8000

# Phase 2 ingest service. The password must match db/init/004_ingest_role.sql (before the volume is first created).
INGEST_DB_PASSWORD=scats_ingest_dev_pw
PARSER_API_PORT=8001
# POST /ingest is DISABLED until this is set. Generate a key and put it here (do not commit .env):
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# Send it as the header X-API-Key. qc-summary also needs it once it is set.
INGEST_API_KEY=
# Development only: allow POST /ingest without a key on a trusted machine.
INGEST_ALLOW_ANONYMOUS=false
