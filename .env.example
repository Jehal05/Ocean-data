# Copy to .env to change defaults. Every value below is also the built-in default.
POSTGRES_USER=scats
POSTGRES_PASSWORD=scats_dev_pw
POSTGRES_DB=scats
DB_PORT=5432

# Password of the API's limited database role. If you change it, also change it in
# db/init/002_app_role.sql BEFORE the database volume is first created.
APP_DB_PASSWORD=scats_app_dev_pw

# S3 credentials. They must match config/seaweedfs-s3.json.
S3_ACCESS_KEY=scatsdev
S3_SECRET_KEY=scatsdev_secret_pw
S3_PORT=8333
STORAGE_UI_PORT=9333
# After the first successful pull, pin the exact image tag here:
# S3_IMAGE=chrislusf/seaweedfs:<tag from `docker compose images`>

API_PORT=8000

# Phase 2 ingest service. The password must match db/init/004_ingest_role.sql (before the volume is first created).
INGEST_DB_PASSWORD=scats_ingest_dev_pw
PARSER_API_PORT=8001
# POST /ingest is DISABLED until this is set. Generate a key and put it here (do not commit .env):
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# Send it as the header X-API-Key. qc-summary also needs it once it is set.
INGEST_API_KEY=
# Development only: allow POST /ingest without a key on a trusted machine.
INGEST_ALLOW_ANONYMOUS=false

# ---- Phase 3: review service ----------------------------------------------------------------------------------
# Password of the review service's database role. Must match db/init/006_review_auth.sql BEFORE the volume is first created.
REVIEW_DB_PASSWORD=scats_review_dev_pw
REVIEW_API_PORT=8002
# Nobody may approve a dataset they ingested themselves. Set false only for a one-person trial.
REVIEW_FOUR_EYES=true
# Approving a dataset also publishes it to the Zarr store (retry with POST /datasets/{key}/publish if that step fails).
PUBLISH_ON_APPROVAL=true
# Set true when the service is reached over https (the session cookie is then marked Secure).
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=28800
# Login rate limit: failures per username / per address inside the window (seconds).
AUTH_MAX_FAILURES_USER=5
AUTH_MAX_FAILURES_IP=20
AUTH_WINDOW_SECONDS=900
# The seed accounts admin / reviewer / viewer (db/init/003) have PUBLISHED passwords. There is no default secret that is safe:
# reset them with POST /admin/users/{username}/reset-password (admin token) before any real use. /health and the login page
# warn while they still work.

# --- Phase 4: derived products and the data access API ---
# DEV PASSWORDS: published in the repository, for local development only. Change them before any real use.
ACCESS_DB_PASSWORD=scats_access_dev_pw
PRODUCTS_DB_PASSWORD=scats_products_dev_pw
